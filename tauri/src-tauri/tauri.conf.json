{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "星云启动器",
  "version": "1.0.68",
  "identifier": "com.cm.blockvibe.launcher",
  "build": {
    "frontendDist": "../../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "星云启动器",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 620,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0a0a0c",
        "center": true
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": true,
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost https: wss: blob: data:; frame-src 'self' https: http:; img-src 'self' https: data: blob: file: asset: http://asset.localhost http://tauri.localhost; media-src 'self' file: https: blob: asset: http://asset.localhost; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../../resources/tools/": "resources/tools/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese"]
      }
    }
  }
}
